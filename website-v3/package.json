{
  "name": "drift-workbench-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:prohibited": "command -v rg >/dev/null && ! rg -n \"bg-(gradient|linear|radial|conic)|\\b(from|via|to)-|shadow-|backdrop-|rounded-full|console\\.log|: any\\b|lorem\" app components lib --glob '!app/globals.css'",
    "lint": "eslint .",
    "format:check": "prettier --check app components lib content"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "^1.3.26",
    "next": "15",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9",
    "eslint-config-next": "15",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  }
}
